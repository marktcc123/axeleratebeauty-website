NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local UI preview only. Ignored in production and on non-localhost hosts.
# Set to true in .env.local, then restart `npm run dev`.
DEV_PREVIEW_AUTH=false

# Supabase (browser-safe project URL/anon key; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (sandbox first). Never collect live charges until the launch checklist is complete.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Catalog source. Keep supabase_cache until one Zoho Commerce SKU is verified.
# Allowed: supabase_cache | zoho_commerce
CATALOG_SOURCE=supabase_cache

# Zoho OAuth — server only. Do not prefix with NEXT_PUBLIC.
# Accounts URL must match the Zoho data center (US: https://accounts.zoho.com).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_REDIRECT_URI=http://localhost:3000/auth/zoho/callback

# Required only when CATALOG_SOURCE=zoho_commerce and Commerce access is granted.
ZOHO_COMMERCE_ORG_ID=
ZOHO_COMMERCE_API_DOMAIN=https://commerce.zoho.com
